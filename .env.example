# Server-only secrets. Replace every placeholder in .env.local or your host.
OPENROUTER_API_KEY="replace-with-openrouter-api-key"
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
AUTH_SECRET="replace-with-at-least-32-random-bytes"
AUTH_GOOGLE_ID="replace-with-google-oauth-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-oauth-client-secret"

# The only Google account allowed to sign in. Access fails closed when unset.
AUTHORIZED_EMAIL="owner@example.com"

OPENROUTER_APP_NAME="OpenRouter Video Studio"
OPENROUTER_SITE_URL="http://localhost:3000"
